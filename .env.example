# DUCSU eVote — copy to .env (repo root) and fill in. Never commit .env.
# The server reads this file; real environment variables override it.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Local:   postgres://postgres:<password>@localhost:5432/ducsu_evote
# Neon/Supabase: use their connection string and set DATABASE_SSL=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ducsu_evote
DATABASE_SSL=false
# Tests use a separate database (its name must contain "test"); it is wiped on every run.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/ducsu_evote_test

# --- Sessions (FR-02) -------------------------------------------------------
SESSION_COOKIE_NAME=sid
# Logged out after this many minutes without a request.
SESSION_IDLE_MINUTES=15
# Hard limit on any session, even an active one.
SESSION_MAX_HOURS=12

# --- OTP login (FR-01) ------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=15
OTP_RESEND_SECONDS=60

# --- Email (FR-17) ----------------------------------------------------------
# console (dev default: prints emails to the server terminal) | smtp (prod default) | memory (tests)
MAIL_TRANSPORT=console
MAIL_FROM="DUCSU eVote <no-reply@ducsu-evote.local>"
# Brevo: smtp-relay.brevo.com:587 · Gmail app password: smtp.gmail.com:465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Development only -------------------------------------------------------
# x-dev-user header (e.g. "x-dev-user: voter:12") lets you act as any user
# without logging in. Always off outside NODE_ENV=development, and the server
# refuses to start if you set it to true anywhere else. Leave this commented.
# DEV_USER_HEADER=true

# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Seeds (dummy demo accounts) --------------------------------------------
# Defaults in development: ec-demo-pass / observer-demo-pass. Required in production.
SEED_EC_PASSWORD=
SEED_OBSERVER_PASSWORD=
